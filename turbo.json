{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "experimentalCargoWorkspaces": true,
    "experimentalTaskCommand": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "papyrus-marketing#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "lint": {},
    "format": {},
    "papyrus-cargo#lint": {
      "command": ["cargo", "clippy", "--workspace", "--all-targets", "--locked", "--", "-D", "warnings"]
    },
    "papyrus-cargo#format": {
      "command": ["cargo", "fmt", "--all", "--check"]
    }
  }
}
